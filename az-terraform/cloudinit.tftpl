#cloud-config
write_files:
  - path: /usr/local/sbin/join-tailscale
    owner: root:root
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      umask 077
      token_file=$(mktemp)
      header_file=$(mktemp)
      secret_file=$(mktemp)
      trap 'rm -f "$token_file" "$header_file" "$secret_file"; unset auth_key token' EXIT

      for attempt in $(seq 1 60); do
        if curl -fsS -H Metadata:true \
          'http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net' \
          > "$token_file" &&
          token=$(jq -er '.access_token' "$token_file") &&
          printf 'header = "Authorization: Bearer %s"\n' "$token" > "$header_file" &&
          curl -fsS --config "$header_file" \
            "${tailscale_secret_url}?api-version=7.4" > "$secret_file" &&
          auth_key=$(jq -er '.value | select(length > 0)' "$secret_file"); then
          break
        fi

        if [ "$attempt" -eq 60 ]; then
          echo "Unable to retrieve the Tailscale auth key from Key Vault after 10 minutes." >&2
          exit 1
        fi
        sleep 10
      done

      tailscale up --ssh --accept-routes --advertise-exit-node \
        --advertise-routes=10.100.1.0/24 --auth-key="$auth_key"
      unset auth_key token

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    owner: root:root
    permissions: '0644'
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    owner: root:root
    permissions: '0644'
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:00";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";

  - path: /etc/rsyslog.d/90-cribl.conf
    owner: root:root
    permissions: '0644'
    content: |
      global(
        DefaultNetstreamDriver="gtls"
        DefaultNetstreamDriverCAFile="/etc/ssl/certs/ca-certificates.crt"
      )
      *.* action(
        type="omfwd"
        target="default.main.pedantic-cori-0p9azq3.cribl.cloud"
        port="6514"
        protocol="tcp"
        StreamDriver="gtls"
        StreamDriverMode="1"
        StreamDriverAuthMode="x509/name"
        StreamDriverPermittedPeers="*.cribl.cloud"
        action.resumeRetryCount="-1"
        queue.type="LinkedList"
        queue.filename="cribl_fwd"
        queue.maxDiskSpace="256m"
        queue.saveOnShutdown="on"
      )

  - path: /home/thirstbeast/.zshrc
    owner: thirstbeast:thirstbeast
    permissions: '0644'
    defer: true
    content: |
      plugins=(gitfast eza fzf tailscale tmux zsh-autosuggestions zsh-syntax-highlighting)
      alias update="sudo apt update && sudo apt upgrade -y && brew update && brew upgrade"
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
      fpath+=("$(brew --prefix)/share/zsh/site-functions")
      source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
      source "$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
      HISTFILE=~/.zsh_history
      HISTSIZE=10000
      SAVEHIST=10000
      setopt INC_APPEND_HISTORY
      autoload -U promptinit; promptinit
      prompt pure
      fastfetch

runcmd:
  - sudo apt update -y
  - sudo apt install -y build-essential
  - sudo apt install -y bubblewrap git python3-pip wget nc vim golang jq eza fzf tmux unattended-upgrades rsyslog rsyslog-gnutls ca-certificates
  - su - thirstbeast -c 'NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
  - su - thirstbeast -c "/home/linuxbrew/.linuxbrew/bin/brew install zsh pure fastfetch zsh-autosuggestions zsh-syntax-highlighting"
  - sudo sh -c 'echo "/home/linuxbrew/.linuxbrew/bin/zsh" >> /etc/shells'
  - sudo chsh -s /home/linuxbrew/.linuxbrew/bin/zsh thirstbeast
  - systemctl enable rsyslog
  - systemctl restart rsyslog
  - curl -fsSL https://tailscale.com/install.sh | sh
  - ['sh', '-c', "echo 'net.ipv4.ip_forward = 1' | sudo tee -a /etc/sysctl.d/99-tailscale.conf && echo 'net.ipv6.conf.all.forwarding = 1' | sudo tee -a /etc/sysctl.d/99-tailscale.conf && sudo sysctl -p /etc/sysctl.d/99-tailscale.conf" ]
  - /usr/local/sbin/join-tailscale
  - tailscale set --relay-server-port=45129